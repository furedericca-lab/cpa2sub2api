{
  "name": "cpa2sub2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "dev": "vite --config front/vite.config.ts --host 127.0.0.1",
    "start": "pnpm dev",
    "build": "vite build --config front/vite.config.ts",
    "preview": "vite preview --config front/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:vendor",
    "browser:install": "node scripts/install-browser.mjs",
    "browser:smoke": "playwright test",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1",
    "pages:deploy": "pnpm build && pnpm verify:dist && wrangler pages deploy dist",
    "verify:vendor": "node scripts/vendor.mjs verify",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.54.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  }
}
